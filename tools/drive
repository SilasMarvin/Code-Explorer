LIMIT_MB = 3000
# Seconds a live window stays open at most; seconds an idle window settles first.
LIVE_SECONDS, IDLE_SETTLE = 1800, 10
# Seconds a session may take: a base, more per step and per waited millisecond, a cap.
BASE_SECONDS, STEP_SECONDS, MOST_SECONDS = 60, 12, 480
# A lock older than this, or whose holder is gone, was left by a killed run.
STALE_LOCK_SECONDS = 900


class Trouble(Exception):
    """A run that could not be made, with why."""


# The guard and the lock.

def tree_mb(pid):
    """Resident memory of a process and its children, in MB."""
    rows = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,rss="],
                          capture_output=True, text=True).stdout.split()
    table = [tuple(map(int, rows[i:i + 3])) for i in range(0, len(rows) - 2, 3)]
    tree = {pid}
    for _ in range(4):
        tree |= {p for p, parent, _ in table if parent in tree}
    return sum(r for p, _, r in table if p in tree) // 1024


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def locked(fn):
    """Runs fn holding the render lock: one viewer window at a time, machine-wide."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    said = False
    while True:
        try:
            LOCK.mkdir()
            (LOCK / "pid").write_text(str(os.getpid()))
            break
        except FileExistsError:
            try:
                holder = (LOCK / "pid").read_text().strip()
                age = time.time() - LOCK.stat().st_mtime
                if (holder and not alive(int(holder))) or age > STALE_LOCK_SECONDS:
                    shutil.rmtree(LOCK, ignore_errors=True)
                    continue
            except (FileNotFoundError, ValueError):
                pass
            if not said:
                print(f"waiting for the render lock ({LOCK})", file=sys.stderr)
                said = True
            time.sleep(1)
    try:
        return fn()
    finally:
        shutil.rmtree(LOCK, ignore_errors=True)


def keep_awake(pid):
    """Wakes the display and keeps it from dimming or sleeping while pid runs: macOS
    draws nothing into a window on a sleeping display, and snaps come out black."""
    if shutil.which("caffeinate"):
        subprocess.Popen(["caffeinate", "-d", "-i", "-u", "-w", str(pid)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def guarded(argv, cwd, log, limit=None, window=True):
    """Runs argv under the memory guard (and a time limit, if given), the display kept
    awake while it has a window; returns its exit code. Raises Trouble when it had
    to be killed."""
    with open(log, "w") as sink:
        p = subprocess.Popen(argv, cwd=cwd, stdout=sink, stderr=subprocess.STDOUT,
                             start_new_session=True)
        if window:
            keep_awake(p.pid)
        start = time.monotonic()
        try:
            while p.poll() is None:
                used = tree_mb(p.pid)
                spent = time.monotonic() - start
                if used > LIMIT_MB or (limit and spent > limit):
                    os.killpg(p.pid, signal.SIGKILL)
                    p.wait()
                    why = f"{used} MB" if used > LIMIT_MB else f"{spent:.0f}s (limit {limit}s)"
                    raise Trouble(f"killed at {why}; see {log}")
                time.sleep(0.2)
        except KeyboardInterrupt:
            os.killpg(p.pid, signal.SIGKILL)
            raise
    return p.returncode


def binary(wt):
    path = Path(wt).resolve() / ".bin" / "codeviz"
    if not path.exists():
        raise Trouble(f"no viewer at {path}; build it: /Users/silas/Projects/cx-tools/cx {Path(wt).resolve()} build")
    return path


# Scripts.

def header_args(script_text):
    """The view args a script's `#: view ...` line gives, with $CODEVIZ_DATA filled in."""
    for line in script_text.splitlines():
        line = line.strip()
        if line.startswith("#:"):
            os.environ.setdefault("CODEVIZ_DATA", DATA)
            return shlex.split(os.path.expandvars(line[2:].strip()))
    return []


def time_limit(script_text):
    lines = [l.strip() for l in script_text.splitlines()]
    steps = [l for l in lines if l and not l.startswith("#")]
    waited = sum(int(l.split()[1]) for l in steps
                 if l.startswith("wait ") and l.split()[1].isdigit()) / 1000
    return min(MOST_SECONDS, BASE_SECONDS + STEP_SECONDS * len(steps) + int(waited))


def shot_script(view_args):
    """Turns the single-shot flags `--keys "K1 K2"` and `--hover UNIT` into a one-snap
    script. Returns the script and the view args without them."""
    steps, rest, i = [], [], 0
    while i < len(view_args):
        arg = view_args[i]
        name, eq, value = arg.partition("=")
        if name in ("--keys", "--hover"):
            if not eq:
                i += 1
                value = view_args[i] if i < len(view_args) else ""
            if name == "--hover":
                steps.append(f"hover {value}")
            else:
                steps.extend(f"key {k}" for k in value.split())
        else:
            rest.append(arg)
        i += 1
    # Hover last: keys first, as the old single shot pressed them.
    steps.sort(key=lambda s: s.startswith("hover"))
    return "\n".join(steps + ["snap"]) + "\n", rest


# Running.

def run_session(name, script, wt=REPO, view_args=None, quiet=False, into=None):
    """Runs one session into `into`/NAME (by default $CODEVIZ_SESSIONS/NAME); returns
    its summary (checks.json, with `name` and `dir`)."""
    script = Path(script).resolve()
    text = script.read_text()
    view_args = view_args or header_args(text)
    if not view_args:
        raise Trouble(f"{script}: no view args: give them after `--`, or a `#: view DATA [FLAGS]` line")
    exe = binary(wt)
    out = Path(into or SESSIONS) / name
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True)
    shutil.copy(script, out / "script.txt")
    (out / "args.txt").write_text(shlex.join(view_args) + "\n")
    log = out / "viewer.log"
    argv = [str(exe), *view_args, "--script", str(script), "--screenshot", str(out)]
    if not quiet:
        print(f"running {name}: {shlex.join(view_args)}", file=sys.stderr)
    code = locked(lambda: guarded(argv, Path(wt).resolve(), log, time_limit(text)))
    if code != 0:
        raise Trouble(f"codeviz exited {code}:\n{viewer_errors(log)}")
    shrink_pngs(out)
    summary_file = out / "checks.json"
    if summary_file.exists():
        summary = json.loads(summary_file.read_text())
        judge_look(out, summary)
        judge_layout(out, summary, exe, view_args)
        summary_file.write_text(json.dumps(summary, indent=2) + "\n")
    else:
        summary = older_summary(out)
    summary.update(name=name, dir=str(out))
    return summary


def check_script(script, wt=REPO, view_args=None):
    """Reads a script and looks up its names in the viewer, no window; raises Trouble
    saying what is wrong."""
    script = Path(script).resolve()
    view_args = view_args or header_args(script.read_text())
    if not view_args:
        raise Trouble(f"{script}: no view args: give them after `--`, or a `#: view DATA [FLAGS]` line")
    exe = binary(wt)
    with tempfile.TemporaryDirectory() as tmp:
        log = Path(tmp) / "check.log"
        argv = [str(exe), *view_args, "--check-script", str(script)]
        if guarded(argv, Path(wt).resolve(), log, 300, window=False) != 0:
            raise Trouble(f"{script.name}:\n{viewer_errors(log)}")


def older_summary(out):
    """A viewer from before the checks writes no checks.json: the failed steps alone."""
    session = out / "session.json"
    steps = json.loads(session.read_text())["steps"] if session.exists() else []
    failed = [s for s in steps if not s.get("ok")]
    print(f"note: {out} has no checks.json (a viewer from before the checks); steps only",
          file=sys.stderr)
    return {"ok": not failed, "checks": {}, "expects": [], "snaps": {},
            "failed_steps": failed}


def viewer_errors(log):
    """The lines of a viewer log that say what went wrong, without Bevy's chatter."""
    lines = Path(log).read_text(errors="replace").splitlines()
    wanted = [l for l in lines if " INFO " not in l and " WARN " not in l and l.strip()]
    return "\n".join("  " + l for l in (wanted or lines)[-20:])


def shrink_pngs(out):
    """Scales each snap's PNG to window points, so pixels match the JSON."""
    for png in sorted(out.glob("[0-9][0-9]-*.png")):
        meta = png.with_suffix(".json")
        try:
            size = max(json.loads(meta.read_text())["window"])
        except (OSError, ValueError, KeyError):
            size = 1600
        subprocess.run(["sips", "-Z", str(int(size)), str(png)], capture_output=True)


# The look: what a snap's PNG shows where its JSON says something faint is drawn.

# Mean RGB level above the ground (0-255) of what is drawn faint, the median over the
# picture, and the window's ground itself. Faint lines are egui strokes blended over the
# 3D picture, spheres 3D meshes: a range missed means something global changed in how
# the picture is drawn (blending, colour space, tonemapping, lighting, Bevy features).
# Measured: faint links 13-15, faint calls inside an expanded module 12-26, faint
# spheres 18-23, ground 18.7; without Bevy's MSAA writeback (bevy_post_process) the
# lines came out alpha-squared, links 1-3 and calls 0-8.
LOOK = {"ground": (16, 22), "faint links": (8, 30), "faint inner calls": (10, 40),
        # Faint spheres up to 33: name pills over big spheres used to darken the samples.
        "faint spheres": (12, 33)}
# The fewest samples a median is judged on.
LOOK_SAMPLES = 5


def picture(png):
    """The PNG's pixels as a function of (x, y) giving the mean of R, G and B."""
    with tempfile.TemporaryDirectory() as tmp:
        bmp = Path(tmp) / "snap.bmp"
        subprocess.run(["sips", "-s", "format", "bmp", str(png), "--out", str(bmp)],
                       capture_output=True, check=True)
        data = bmp.read_bytes()
    start = int.from_bytes(data[10:14], "little")
    width = int.from_bytes(data[18:22], "little", signed=True)
    height = int.from_bytes(data[22:26], "little", signed=True)
    depth = int.from_bytes(data[28:30], "little") // 8
    stride = (width * depth + 3) // 4 * 4

    def level(x, y):
        x, y = min(max(int(x), 0), width - 1), min(max(int(y), 0), abs(height) - 1)
        row = y if height < 0 else height - 1 - y
        at = start + row * stride + x * depth
        return sum(data[at:at + 3]) / 3

    return width, abs(height), level


def look_of(snap, level, size):
    """Each faint thing's samples, in levels above the ground."""
    width, height = size
    dots = [n["at"] for n in snap.get("nodes", []) if n.get("on_screen") and n.get("radius", 0) > 0]
    rects = [l["rect"] for l in snap.get("labels", [])]
    ground = statistics.median(level(x, y) for x in range(5, width, 41) for y in range(5, height, 43))
    whole_map = (snap["state"]["mode"] == "browse" and not snap["state"].get("expanded")
                 and not snap["content"].get("selection"))
    samples = {}

    def line_samples(what, arrows):
        for a in arrows:
            if not a.get("on_screen") or a.get("drawn") is False:
                continue
            for (x0, y0), (x1, y1) in zip(a["path"], a["path"][1:]):
                length = ((x1 - x0) ** 2 + (y1 - y0) ** 2) ** 0.5
                if length < 30:
                    continue
                # The line's brightest pixel near its middle, over the darker side of it.
                across = (-(y1 - y0) / length * 6, (x1 - x0) / length * 6)
                for t in (0.4, 0.5, 0.6):
                    x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
                    if (not (8 < x < width - 8 and 30 < y < height - 30)
                            or any((x - d[0]) ** 2 + (y - d[1]) ** 2 < 100 for d in dots)
                            or any(r[0] - 4 < x < r[2] + 4 and r[1] - 4 < y < r[3] + 4 for r in rects)):
                        continue
                    peak = max(level(x + i, y + j) for i in (-1, 0, 1) for j in (-1, 0, 1))
                    side = min(level(x + s * across[0], y + s * across[1]) for s in (-1, 1))
                    samples.setdefault(what, []).append(peak - side)

    if whole_map:
        samples["ground"] = [ground]
        line_samples("faint links", snap.get("module_arrows", []))
        for m in snap.get("modules", []):
            if m.get("body") != "faint" or not m.get("on_screen") or m.get("radius", 0) < 12:
                continue
            for k in range(16):
                x = m["at"][0] + 0.6 * m["radius"] * math.cos(k * math.pi / 8)
                y = m["at"][1] + 0.6 * m["radius"] * math.sin(k * math.pi / 8)
                if not any((x - d[0]) ** 2 + (y - d[1]) ** 2 < 49 for d in dots):
                    samples.setdefault("faint spheres", []).append(level(x, y) - ground)
    line_samples("faint inner calls", [a for a in snap.get("arrows", [])
                                       if a.get("flow") == "inner" and "(faint)" in a.get("role", "")])
    return samples


def judge_look(out, summary):
    """Adds the check `look` to a session's summary: on each snap with a PNG showing
    something faint enough to sample, each faint thing's median level within LOOK."""
    tally = {"failed": 0, "failed_in": [], "not_applied": 0, "pass": True, "passed": 0}
    for name, checks in summary.get("snaps", {}).items():
        png, meta = out / f"{name}.png", out / f"{name}.json"
        if not png.exists() or not meta.exists():
            continue
        snap = json.loads(meta.read_text())
        # A picture that will not convert (a full disk, say) leaves its look unjudged.
        try:
            width, height, pixel = picture(png)
        except (subprocess.CalledProcessError, OSError) as e:
            err = (getattr(e, "stderr", None) or b"").decode(errors="replace").strip() or str(e)
            checks["look"] = {"pass": None, "why": "picture did not convert", "error": err}
            tally["not_applied"] += 1
            continue
        # A PNG left at the screen's scale (a run that stopped before shrinking it).
        scale = width / snap["window"][0]

        def level(x, y):
            return pixel(x * scale, y * scale)

        measured, offenders = {}, []
        for what, values in look_of(snap, level, (round(width / scale), round(height / scale))).items():
            if len(values) < (1 if what == "ground" else LOOK_SAMPLES):
                continue
            median = round(statistics.median(values), 1)
            measured[what] = median
            low, high = LOOK[what]
            if not low <= median <= high:
                offenders.append({"what": what, "median": median, "range": [low, high],
                                  "samples": len(values)})
        if not measured:
            checks["look"] = {"pass": None, "why": "nothing faint to sample"}
            tally["not_applied"] += 1
            continue
        checks["look"] = {"pass": not offenders, "measured": measured}
        if offenders:
            checks["look"].update(count=len(offenders), offenders=offenders)
            tally["failed"] += 1
            tally["failed_in"].append(name)
            tally["pass"] = False
            summary["ok"] = False
        else:
            tally["passed"] += 1
    summary.setdefault("checks", {})["look"] = tally


# The layout: the same for the same document, every run.

def judge_layout(out, summary, exe, view_args):
    """Adds the check `layout-same` to a session's summary: every snap's layout digest
    the same, and the same as the last session run with this build on this document
    (kept in $CODEVIZ_SESSIONS/.layouts.json): the layout is worked out alike every
    time."""
    digests = {}
    for name in summary.get("snaps", {}):
        meta = out / f"{name}.json"
        if meta.exists():
            digest = (json.loads(meta.read_text()).get("layout") or {}).get("digest")
            if digest:
                digests[name] = digest
    if not digests:
        return
    built = Path(exe).stat()
    key = f"{Path(exe).resolve()}|{built.st_mtime_ns}|{built.st_size}|{view_args[1] if len(view_args) > 1 else ''}"
    record = Path(SESSIONS) / ".layouts.json"
    try:
        known = json.loads(record.read_text())
    except (OSError, ValueError):
        known = {}
    first = next(iter(digests.values()))
    before = known.get(key, first)
    tally = {"failed": 0, "failed_in": [], "not_applied": 0, "pass": True, "passed": 0}
    for name, digest in digests.items():
        ok = digest == first == before
        check = {"pass": ok, "digest": digest}
        if not ok:
            check.update(count=1, offenders=[{"digest": digest, "first_this_run": first,
                                              "last_run": before, "why": "laid out differently"}])
            tally["failed"] += 1
            tally["failed_in"].append(name)
            tally["pass"] = False
            summary["ok"] = False
        else:
            tally["passed"] += 1
        summary["snaps"][name]["layout-same"] = check
    summary.setdefault("checks", {})["layout-same"] = tally
    known[key] = first
    try:
        record.write_text(json.dumps(known, indent=1) + "\n")
    except OSError:
        pass


# Reading a session.

def brief(value, width=150):
    text = json.dumps(value, ensure_ascii=False)
    return text if len(text) <= width else text[:width - 1] + "…"


def failing_checks(summary):
    """Each check that failed on some snap: its name, the snaps, the worst offender."""
    out = []
    for name, check in summary.get("checks", {}).items():
        if check.get("pass"):
            continue
        snaps = check.get("failed_in", [])
        first = next((summary["snaps"][s][name] for s in snaps if s in summary.get("snaps", {})), {})
        out.append((name, snaps, first))
    return out


def verdict(summary):
    """PASS, FAIL (the view: a step, an expect or a check), or NOT DRAWN: the view
    passed, but macOS drew nothing into the window for some snaps, so they have no
    PNG to look at."""
    if not summary.get("ok"):
        return "FAIL"
    return "NOT DRAWN" if summary.get("window_not_drawn") else "PASS"


def report(summary):
    """The summary as an agent reads it: verdict, failed steps, expects, checks."""
    snaps = summary.get("snaps", {})
    steps = summary.get("failed_steps", [])
    expects = summary.get("expects", [])
    lines = [f"{summary.get('dir', '')}: {len(snaps)} snaps, {len(expects)} expects — "
             + verdict(summary)]
    blank = summary.get("window_not_drawn", [])
    if blank:
        lines.append(f"  window not drawn: {len(blank)} snaps have no PNG ({', '.join(blank)}); "
                     "macOS drew nothing into the window (display asleep or locked, or something "
                     "over its corner). Their JSON and checks hold; run again for the pictures.")
    for s in steps:
        if str(s.get("do", "")).startswith("expect "):
            continue
        lines.append(f"  step {s.get('step')} (line {s.get('line')}) `{s.get('do')}`: "
                     + "; ".join(s.get("trouble") or []))
    for n in summary.get("notes", []):
        lines.append(f"  note, step {n.get('step')} (line {n.get('line')}) `{n.get('do')}`: "
                     + "; ".join(n.get("note") or []))
    for e in expects:
        if not e.get("ok"):
            lines.append(f"  expect failed, line {e.get('line')} `{e.get('expect')}`: {e.get('why')}")
    for name, failed_in, first in failing_checks(summary):
        count = first.get("count", "")
        example = (first.get("offenders") or [first.get("why")])[0]
        lines.append(f"  check {name} failed in {', '.join(failed_in)}"
                     + (f" ({count} offenders in {failed_in[0]})" if count else "")
                     + f": {brief(example)}")
    return "\n".join(lines)


def read(name):
    path = Path(name)
    if not path.is_dir():
        path = SESSIONS / name
    summary = json.loads((path / "checks.json").read_text())
    summary.update(name=path.name, dir=str(path))
    return summary


# The suite.

def suite(wt, only, prefix):
    scripts = sorted(p for p in SCRIPTS.glob("*.txt") if not only or any(o in p.stem for o in only))
    if not scripts:
        raise Trouble(f"no scripts in {SCRIPTS} match {only}")
    # Every name in every script first, so a typo fails before any window opens.
    problems = []
    for script in scripts:
        try:
            check_script(script, wt)
        except Trouble as error:
            problems.append(str(error))
    if problems:
        raise Trouble("\n".join(problems))
    rows = []
    for script in scripts:
        name = prefix + script.stem
        try:
            summary = run_session(name, script, wt)
        except Trouble as error:
            summary = {"name": name, "ok": False, "error": str(error), "dir": str(SESSIONS / name)}
        rows.append((script.stem, summary))
        print(f"  {script.stem}: {verdict(summary) if 'error' not in summary else 'ERROR'}",
              file=sys.stderr)
    print(table(rows))
    (SESSIONS / f"{prefix}suite.json").write_text(json.dumps(
        {stem: {k: v for k, v in s.items() if k != "snaps"} for stem, s in rows}, indent=2) + "\n")
    return all(verdict(s) == "PASS" for _, s in rows)


def table(rows):
    """The pass/fail table, then what failed in each script."""
    head = ("script", "steps", "expects", "failing checks", "verdict")
    body = []
    for stem, s in rows:
        if "error" in s:
            body.append((stem, "-", "-", "did not run", "ERROR"))
            continue
        steps = [x for x in s.get("failed_steps", []) if not str(x.get("do", "")).startswith("expect ")]
        expects = s.get("expects", [])
        bad = [e for e in expects if not e.get("ok")]
        checks = [n for n, _, _ in failing_checks(s)]
        body.append((stem, f"{len(steps)} failed", f"{len(expects) - len(bad)}/{len(expects)} ok",
                     ", ".join(checks) or "none", verdict(s).lower() if s.get("ok") else "FAIL"))
    widths = [max(len(str(r[i])) for r in [head] + body) for i in range(len(head) - 1)]
    fmt = lambda r: "  ".join(str(c).ljust(w) for c, w in zip(r, widths)) + "  " + r[-1]
    out = [fmt(head), fmt(tuple("-" * w for w in widths) + ("-------",))]
    out += [fmt(r) for r in body]
    passed = sum(1 for _, s in rows if s.get("ok"))
    blank = sum(1 for _, s in rows if "error" not in s and verdict(s) == "NOT DRAWN")
    out.append(f"\n{passed}/{len(rows)} scripts pass"
               + (f"; {blank} of them with the window not drawn for some snaps (no PNG)" if blank else ""))
    for stem, s in rows:
        if verdict(s) == "PASS" and "error" not in s:
            continue
        out.append("")
        out.append(s["error"] if "error" in s else report(s))
    return "\n".join(out)


# Command line.

def split_view_args(args):
    if "--" in args:
        i = args.index("--")
        return args[:i], args[i + 1:]
    return args, []


def option(args, flag, default=None, many=False):
    found, rest, i = [], [], 0
    while i < len(args):
        if args[i] == flag and i + 1 < len(args):
            found.append(args[i + 1])
            i += 2
        else:
            rest.append(args[i])
            i += 1
    args[:] = rest
    return found if many else (found[-1] if found else default)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    command, args = argv[0], argv[1:]
    if Path(command).is_dir() and len(args) >= 2:
        # The older form: WORKTREE NAME SCRIPT -- VIEW ARGS.
        command, args = "run", [*args[:2], "--wt", command, *args[2:]]
    mine, view_args = split_view_args(args)
    wt = option(mine, "--wt", str(REPO))
    if command == "run":
        if len(mine) != 2:
            raise Trouble("usage: tools/drive run NAME SCRIPT [--wt DIR] [-- VIEW ARGS]")
        summary = run_session(mine[0], mine[1], wt, view_args)
        print(report(summary))
        return {"PASS": 0, "FAIL": 1}.get(verdict(summary), 2)
    if command == "suite":
        only = option(mine, "--only", many=True)
        prefix = option(mine, "--prefix", "suite-")
        return 0 if suite(wt, only, prefix) else 1
    if command == "check":
        if not mine:
            raise Trouble("usage: tools/drive check SCRIPT... [--wt DIR] [-- VIEW ARGS]")
        for script in mine:
            check_script(script, wt, view_args)
            print(f"{script}: ok")
        return 0
    if command == "read":
        if len(mine) != 1:
            raise Trouble("usage: tools/drive read NAME")
        summary = read(mine[0])
        print(report(summary))
        return {"PASS": 0, "FAIL": 1}.get(verdict(summary), 2)
    if command == "shot":
        if len(mine) != 1:
            raise Trouble("usage: tools/drive shot NAME [--wt DIR] -- VIEW ARGS [--keys K] [--hover UNIT]")
        return shot(mine[0], wt, view_args)
    if command == "live":
        limit = int(option(mine, "--limit", LIVE_SECONDS))
        target = mine[0] if mine else wt
        argv = [str(binary(target)), *view_args]
        return locked(lambda: guarded(argv, Path(target).resolve(), os.devnull, limit))
    if command == "idle":
        seconds = float(option(mine, "--seconds", 10))
        share = idle(wt, view_args, seconds)
        print(f"idle: {share:.1%} of a core over {seconds:.0f} s ({shlex.join(view_args)})")
        return 0
    raise Trouble(f"unknown command `{command}`; see tools/drive --help")


def cpu_seconds(pid):
    """CPU time a process and its children have used, in seconds."""
    rows = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,cputime="],
                          capture_output=True, text=True).stdout.splitlines()
    table = [row.split() for row in rows if len(row.split()) == 3]
    tree = {pid}
    for _ in range(4):
        tree |= {int(p) for p, parent, _ in table if int(parent) in tree}
    total = 0.0
    for p, _, time_used in table:
        if int(p) in tree:
            parts = [float(x) for x in time_used.replace("-", ":").split(":")]
            total += sum(v * 60 ** i for i, v in enumerate(reversed(parts)))
    return total


def idle(wt, view_args, seconds):
    """Opens the viewer with no script under the lock and the memory guard, lets it
    settle, and returns the share of a core it uses over `seconds` while left alone."""
    if not view_args:
        raise Trouble("usage: tools/drive idle [--wt DIR] [--seconds N] -- VIEW ARGS")
    argv = [str(binary(wt)), *view_args]

    def measure():
        env = dict(os.environ, CODEVIZ_TUCKED="1")
        p = subprocess.Popen(argv, cwd=Path(wt).resolve(), stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True, env=env)
        keep_awake(p.pid)
        try:
            deadline = time.monotonic() + IDLE_SETTLE
            while time.monotonic() < deadline:
                if p.poll() is not None:
                    raise Trouble(f"the viewer exited {p.returncode} before it settled")
                if tree_mb(p.pid) > LIMIT_MB:
                    raise Trouble(f"killed past {LIMIT_MB} MB")
                time.sleep(0.2)
            start, began = cpu_seconds(p.pid), time.monotonic()
            time.sleep(seconds)
            return (cpu_seconds(p.pid) - start) / (time.monotonic() - began)
        finally:
            if p.poll() is None:
                os.killpg(p.pid, signal.SIGKILL)
                p.wait()

    return locked(measure)


def shot(name, wt, view_args):
    script_text, view_args = shot_script(view_args)
    SHOTS.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        script = Path(tmp) / "shot.txt"
        script.write_text(script_text)
        summary = run_session("session", script, wt, view_args, quiet=True, into=tmp)
        out = Path(summary["dir"])
        png = next(out.glob("[0-9][0-9]-*.png"), None)
        meta = next(out.glob("[0-9][0-9]-*.json"), None)
        if png is None and summary.get("window_not_drawn"):
            raise Trouble("window not drawn: macOS drew nothing into it (display asleep or "
                          "locked, or something over its corner); run again")
        if png is None or meta is None:
            raise Trouble(f"the snap was not taken:\n{viewer_errors(out / 'viewer.log')}")
        shutil.copy(png, SHOTS / f"{name}.png")
        snap = json.loads(meta.read_text())
        (SHOTS / f"{name}.json").write_text(json.dumps(snap, indent=2) + "\n")
        (SHOTS / f"{name}.truth.json").write_text(json.dumps(snap.get("content"), indent=2) + "\n")
        for s in summary.get("failed_steps", []):
            print(f"step `{s.get('do')}`: {'; '.join(s.get('trouble') or [])}", file=sys.stderr)
    print(SHOTS / f"{name}.png")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Trouble as error:
        print(error, file=sys.stderr)
        sys.exit(2)
