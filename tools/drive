#!/usr/bin/env python3
"""tools/drive: drive the real codeviz viewer from a script and check what it shows.

  tools/drive run NAME SCRIPT [--wt DIR] [-- VIEW ARGS]
      Runs SCRIPT in one viewer window and writes $CODEVIZ_SESSIONS/NAME/: a PNG and a
      JSON per `snap`, with the checks run on it; session.json (every step); checks.json
      (the checks, `expect` lines and failed steps, summed up). Prints the summary.
      VIEW ARGS default to the script's `#: view ...` line.
  tools/drive suite [--wt DIR] [--only TEXT]... [--prefix P]
      Runs every tools/scripts/*.txt (or those whose name holds TEXT), one window at a
      time, and prints a pass/fail table and the failing checks and expects.
  tools/drive check SCRIPT... [--wt DIR]
      Reads each script and looks up every function and module it names, without
      opening a window: a misspelt name is reported with the nearest ones.
  tools/drive read NAME
      Prints the summary of a session already run.
  tools/drive shot NAME [--wt DIR] -- VIEW ARGS [--keys "K1 K2"] [--hover UNIT]
      One picture: $CODEVIZ_SHOTS/NAME.png, NAME.json (the snap) and NAME.truth.json.
  tools/drive live [DIR] [--limit SECONDS] -- VIEW ARGS
      An interactive window under the memory guard and the render lock, closed after
      SECONDS (default 1800).
  tools/drive idle [--wt DIR] [--seconds N] -- VIEW ARGS
      Opens the viewer as a person would (no script), but tucked away as a session's
      window is (CODEVIZ_TUCKED: unfocused, all but a corner off screen, click-through),
      lets it settle, and prints how much of a core it uses over N seconds (default 10)
      while nothing happens.
  tools/drive WORKTREE NAME SCRIPT -- VIEW ARGS
      The older form of `run`.

The viewer is DIR/.bin/codeviz (build it with `cx DIR build`), run from DIR; DIR is this
repo unless --wt says otherwise. Every run is killed past 3000 MB or its time limit, and
takes a lock so only one viewer window renders at a time across all agents.

Script steps (one per line; `#` comments; `#: view DATA [FLAGS]` gives the view args):
  key K               x . , up down left right [ ] enter esc space tab backspace /,
                      a letter or digit; shift+K
  type TEXT           types into the focused text box (the search box after `key /`)
  click UNIT          clicks the function's dot      click X Y    clicks a point
  click-label UNIT    clicks the function's drawn name
  click-empty         clicks the graph clear of every dot, name and overlay
  hover UNIT          rests the pointer on the dot   hover-label UNIT   on its name
  shift+click UNIT    doubleclick UNIT               doubleclick-module MODULE
  bar N               clicks journey bar N (1.2), or the bar of function N (the start's first)
  chip N              clicks the badge on bar N that unfolds what is folded under it
  search-pick TEXT    clicks the search row that says TEXT (or finds the function TEXT)
  button TEXT         clicks the button that says TEXT (`button Fit` frames as F does)
  drag DX DY          orbits by a left drag     pan DX DY    pans by a right drag
  scroll N | scroll DX DY [at UNIT | at X Y]   wheel notches; positive DY zooms in
  window W H          resizes the window (points)
  wait MS             snap [LABEL]
  frames N            snaps each of the next N frames as the step before plays out
  expect mode browse|journey   expect nucleus modules|expanded   expect depth N
  expect search|help|back|forward|outside_callers true|false
  expect selection|cursor|start UNIT|none     expect named|drawn UNIT
  expect camera-same-as LABEL  expect nothing-moved   expect check NAME [pass|fail]
UNIT is found as --focus finds it (an id suffix like orders::place, or an entry label);
a name that matches nothing, or many, stops the script before the window opens, with
the nearest names. See docs/harness.md for the JSON fields and every check.

Environment: CODEVIZ_SESSIONS (default /Users/silas/Projects/cx-tools/sessions),
CODEVIZ_SHOTS (default /Users/silas/Projects/cx-tools/shots), CODEVIZ_DATA (default
/Users/silas/Projects/cx-tools/data; `$CODEVIZ_DATA` in a `#: view` line), CODEVIZ_LOCK.
"""
import json
import math
import os
import shlex
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TOOLS = Path("/Users/silas/Projects/cx-tools")
SESSIONS = Path(os.environ.get("CODEVIZ_SESSIONS", TOOLS / "sessions"))
SHOTS = Path(os.environ.get("CODEVIZ_SHOTS", TOOLS / "shots"))
DATA = os.environ.get("CODEVIZ_DATA", str(TOOLS / "data"))
# The same lock the older cx-tools `shot` took, so old and new never render at once.
LOCK = Path(os.environ.get("CODEVIZ_LOCK", TOOLS / "shots" / ".lock"))
