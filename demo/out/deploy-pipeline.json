      },
      "attributes": {
        "artifact_paths": "image-digest.txt",
        "label": ":docker: Build image"
      },
      "calls": [
        {
          "key": "./scripts/docker-build.sh \"$IMAGE:$BUILDKITE_COMMIT\"#0",
          "text": "./scripts/docker-build.sh \"$IMAGE:$BUILDKITE_COMMIT\"",
          "targets": [
            {
              "unit": "script:scripts/docker-build.sh",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/integration",
      "name": "Integration tests",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "label": ":globe_with_meridians: Integration tests",
        "plugins.docker-compose.config": "demo/axum-server/docker-compose.ci.yml",
        "plugins.docker-compose.run": "integration",
        "retry.automatic.limit": 2
      },
      "calls": [
        {
          "key": "docker-compose#v5.10.0#0",
          "text": "docker-compose#v5.10.0",
          "targets": [
            {
              "unit": "buildkite-plugin:docker-compose",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "buildkite-agent artifact download image-digest.txt .#0",
          "text": "buildkite-agent artifact download image-digest.txt .",
          "targets": [],
          "propagates": true
        },
        {
          "key": "./scripts/integration.sh#0",
          "text": "./scripts/integration.sh",
          "targets": [
            {
              "unit": "script:scripts/integration.sh",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/lint",
      "name": "Lint",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "label": ":rust: Lint",
        "plugins.docker-compose.config": "demo/axum-server/docker-compose.ci.yml",
        "plugins.docker-compose.run": "ci"
      },
      "calls": [
        {
          "key": "docker-compose#v5.10.0#0",
          "text": "docker-compose#v5.10.0",
          "targets": [
            {
              "unit": "buildkite-plugin:docker-compose",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "cargo fmt --all --check#0",
          "text": "cargo fmt --all --check",
          "targets": [],
          "propagates": true
        },
        {
          "key": "cargo clippy -p axum-server --all-targets -- -D warnings#0",
          "text": "cargo clippy -p axum-server --all-targets -- -D warnings",
          "targets": [],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/migrate",
      "name": "Migrate",
      "kind": "trigger",
      "role": "invocable",
      "parent": "buildkite:orders-deploy/deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "build.branch": "$BUILDKITE_BRANCH",
        "build.commit": "$BUILDKITE_COMMIT",
        "build.env.TARGET": "production",
        "label": ":database: Migrate"
      },
      "calls": [
        {
          "key": "orders-migrations#0",
          "text": "orders-migrations",
          "targets": [
            {
              "unit": "buildkite:orders-migrations",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/notify",
      "name": "Notify",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "allow_dependency_failure": true,
        "key_derived": true,
        "label": ":speech_balloon: Notify"
      },
      "calls": [
        {
          "key": "./scripts/notify.sh \"#orders-deploys\"#0",
          "text": "./scripts/notify.sh \"#orders-deploys\"",
          "targets": [
            {
              "unit": "script:scripts/notify.sh",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ]
    },
    {
