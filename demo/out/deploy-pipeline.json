      "name": "Deploy worker",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy/deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "agents.queue": "deploy",
        "concurrency": 1,
        "concurrency_group": "orders/production",
        "label": ":kubernetes: Deploy worker"
