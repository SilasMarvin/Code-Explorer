{
  "schema": "codeviz/0.1",
  "producer": {
    "name": "codeviz-buildkite",
    "version": "0.1.0"
  },
  "units": [
    {
      "id": "buildkite-plugin:docker-compose",
      "name": "docker-compose",
      "kind": "plugin",
      "role": "external"
    },
    {
      "id": "buildkite:orders-deploy",
      "name": "orders-deploy",
      "kind": "pipeline",
      "role": "invocable",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "agents.queue": "build",
        "env.CARGO_TERM_COLOR": "always",
        "env.IMAGE": "registry.example.com/orders/axum-server"
      },
      "calls": [
        {
          "key": "lint#0",
          "text": "lint",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/lint",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "build#0",
          "text": "build",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/build",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "unit-tests#0",
          "text": "unit-tests",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/unit-tests",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "test-matrix#0",
          "text": "test-matrix",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/test-matrix",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "cargo-audit#0",
