    {
      "id": "buildkite:orders-deploy/test-matrix",
      "name": "Test / rust",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "agents.queue": "test",
        "instances": 4,
        "label": ":test_tube: Test {{matrix.os}} / rust {{matrix.rust}}",
        "matrix.adjustments.0.soft_fail": true,
        "matrix.adjustments.0.with.os": "linux",
        "matrix.adjustments.0.with.rust": "nightly",
        "matrix.adjustments.1.soft_fail": true,
        "matrix.adjustments.1.with.os": "macos",
        "matrix.adjustments.1.with.rust": "nightly",
        "matrix.setup.os": "linux, macos",
        "matrix.setup.rust": "1.99, nightly"
      },
      "calls": [
        {
          "key": "cargo test -p axum-server --locked#0",
          "text": "cargo test -p axum-server --locked",
          "targets": [],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/unit-tests",
      "name": "Unit tests",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "instances": 4,
        "label": ":test_tube: Unit tests",
        "parallelism": 4,
        "retry.automatic.0.exit_status": -1,
        "retry.automatic.0.limit": 2
      },
      "calls": [
