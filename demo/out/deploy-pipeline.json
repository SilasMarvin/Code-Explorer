      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "build.commit": "$BUILDKITE_COMMIT",
        "label": ":mag: Post-deploy checks"
      },
      "calls": [
        {
          "key": "post-deploy-checks#0",
          "text": "post-deploy-checks",
          "targets": [
            {
              "unit": "buildkite:post-deploy-checks",
              "certainty": "exact"
            }
          ],
          "mode": "spawn"
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/push-image",
      "name": "Push image",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "concurrency": 1,
