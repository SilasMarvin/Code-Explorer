            }
          ],
          "propagates": true
        },
        {
          "key": "image#0",
          "text": "image",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/image",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "integration#0",
          "text": "integration",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/integration",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "push-image#0",
          "text": "push-image",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/push-image",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "release#0",
          "text": "release",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/release",
              "certainty": "exact"
            }
          ]
        },
        {
          "key": "migrate#0",
          "text": "migrate",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/migrate",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "deploy-api#0",
          "text": "deploy-api",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/deploy-api",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "deploy-worker#0",
          "text": "deploy-worker",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/deploy-worker",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "smoke#0",
          "text": "smoke",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/smoke",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "post-deploy#0",
          "text": "post-deploy",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/post-deploy",
              "certainty": "exact"
            }
          ],
          "propagates": true
        },
        {
          "key": "notify#0",
          "text": "notify",
          "targets": [
            {
              "unit": "buildkite:orders-deploy/notify",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ],
      "body": [
        {
          "step": "dag",
          "nodes": [
            {
              "id": "lint",
              "body": [
                {
                  "step": "call",
                  "call": "lint#0"
                }
              ]
            },
            {
              "id": "build",
              "body": [
                {
                  "step": "call",
                  "call": "build#0"
                }
              ]
            },
            {
              "id": "unit-tests",
              "after": [
                "build"
              ],
              "body": [
                {
                  "step": "call",
                  "call": "unit-tests#0"
                }
              ]
            },
            {
              "id": "test-matrix",
              "after": [
                "build"
              ],
              "body": [
                {
                  "step": "call",
                  "call": "test-matrix#0"
                }
              ]
            },
            {
              "id": "cargo-audit",
              "body": [
                {
                  "step": "call",
                  "call": "cargo-audit#0"
                }
              ]
            },
            {
              "id": "wait",
              "after": [
                "lint",
                "build",
                "unit-tests",
                "test-matrix",
                "cargo-audit"
              ],
              "body": []
            },
            {
              "id": "image",
              "after": [
                "wait"
              ],
              "body": [
                {
                  "step": "call",
                  "call": "image#0"
                }
              ]
            },
            {
              "id": "integration",
              "after": [
                "image",
                "unit-tests",
                "test-matrix"
              ],
              "body": [
                {
                  "step": "call",
                  "call": "integration#0"
                }
              ]
            },
            {
              "id": "wait-2",
              "after": [
                "image",
                "integration",
                "wait"
              ],
              "body": []
            },
            {
              "id": "push-image",
              "after": [
                "wait-2"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "push-image#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "release",
              "after": [
                "push-image"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "release#0"
                        },
                        {
                          "step": "branch",
                          "guard": "release unblocked",
                          "arms": [
                            {
                              "label": "unblocked",
                              "body": []
                            },
                            {
                              "label": "blocked",
                              "body": [
                                {
                                  "step": "exit",
                                  "kind": "return",
                                  "label": "build left blocked"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "migrate",
              "after": [
                "release"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "migrate#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "deploy-api",
              "after": [
                "release",
                "migrate"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "deploy-api#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "deploy-worker",
              "after": [
                "release",
                "migrate"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "deploy-worker#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "wait-3",
              "after": [
                "release",
                "migrate",
                "deploy-api",
                "deploy-worker"
              ],
              "body": []
            },
            {
              "id": "smoke",
              "after": [
                "release",
                "wait-3"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "smoke#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "deploy",
              "after": [
                "release",
                "smoke"
              ],
              "body": []
            },
            {
              "id": "post-deploy",
              "after": [
                "deploy"
              ],
              "body": [
                {
                  "step": "branch",
                  "guard": "build.branch == \"main\"",
                  "arms": [
                    {
                      "label": "true",
                      "body": [
                        {
                          "step": "call",
                          "call": "post-deploy#0"
                        }
                      ]
                    },
                    {
                      "label": "false",
                      "body": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "wait-4",
              "after": [
                "deploy",
                "post-deploy",
                "release"
              ],
              "body": []
            },
            {
              "id": "notify",
              "after": [
                "wait-4"
              ],
              "body": [
                {
                  "step": "call",
                  "call": "notify#0"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/build",
      "name": "Build",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "artifact_paths": "target/release/axum-server, target/release/axum-server.sha256",
        "label": ":hammer: Build",
        "retry.automatic": true
      },
      "calls": [
        {
          "key": "./scripts/build.sh --release#0",
          "text": "./scripts/build.sh --release",
          "targets": [
            {
              "unit": "script:scripts/build.sh",
              "certainty": "exact"
            }
          ],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/cargo-audit",
      "name": "cargo audit",
      "kind": "step",
      "role": "invocable",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "key_derived": true,
        "label": ":lock: cargo audit",
        "soft_fail": "1"
      },
      "calls": [
        {
          "key": "cargo audit --deny warnings#0",
          "text": "cargo audit --deny warnings",
          "targets": [],
          "propagates": true
        }
      ]
    },
    {
      "id": "buildkite:orders-deploy/deploy",
      "name": "Deploy production",
      "kind": "group",
      "role": "group",
      "parent": "buildkite:orders-deploy",
      "location": {
        "uri": "demo/pipelines/deploy.yml"
      },
      "attributes": {
        "label": ":rocket: Deploy production"
      }
    },
    {
      "id": "buildkite:orders-deploy/deploy-api",
